# Copy this file to .env.local and fill in real values.
# NEXT_PUBLIC_* vars are shipped to the browser — never put real secrets there.

# ─── Supabase ──────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only — bypasses Row Level Security. Used by API routes via supabaseAdmin.
SUPABASE_SERVICE_ROLE_KEY=

# ─── Kitchen board ─────────────────────────────────────────────
# Staff password for the /kitchen board. Server-only (NOT NEXT_PUBLIC_) — it
# never reaches the browser; staff exchange it for an httpOnly session cookie.
# Leave unset in local dev and the board runs open; SET IT IN PRODUCTION.
KITCHEN_PASSWORD=

# ─── Manager admin (/admin) ────────────────────────────────────
# Password for the local manager admin (prices/discounts/customers). The admin
# is LOCKED unless this is set, and it edits repo config files (writes only work
# locally). Set it ONLY in your local .env.local — do NOT set it on Vercel, so
# /admin stays inert in production.
ADMIN_PASSWORD=

# ─── Payment provider ──────────────────────────────────────────
# tranzila (default) | yaadpay | hyp
PAYMENT_PROVIDER=tranzila

# Tranzila — https://www.tranzila.com/developers
TRANZILA_TERMINAL=

# YaadPay (alternate provider) — https://yaadpay.docs.apiary.io/
YAADPAY_MASOF=
YAADPAY_PASSP=

# Hyp Pay (formerly YaadPay) — https://developers.hyp.co.il/
# From the Hyp Pay portal: Settings -> "Payment Page and API" -> "Verification"
# Also configure the portal's "Post-transaction address" (success page) to
# point at https://yourdomain.com/api/payment/hyp/return
HYP_MASOF=
HYP_KEY=
HYP_PASSP=


# Used by the Google Reviews strip on the homepage
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=

# Base URL used to build payment success/fail redirect links
NEXT_PUBLIC_APP_URL=http://localhost:3000
