# Copy this file to .env.local and fill in real values.
# NEXT_PUBLIC_* vars are shipped to the browser — never put real secrets there.

# ─── Supabase ──────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Preferred public key. The legacy ANON name below remains supported while
# migrating existing deployments; set one public key, not a secret, here.
# The app deliberately stops its build if a secret/service-role key is pasted
# into either NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Preferred server-only key. The legacy service-role name remains supported.
# Both bypass Row Level Security and must never use a NEXT_PUBLIC_ prefix.
# A publishable/anon key in either server slot is rejected as misconfiguration.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Exact opt-in for an intentionally public demo deployment. With this unset,
# zero credentials run demo only in development/test; production fails closed.
# Do not combine this with real Supabase credentials.
NEXT_PUBLIC_BARIBALI_DEMO_MODE=

# ─── Kitchen board ─────────────────────────────────────────────
# Staff password for the /kitchen board. Server-only (NOT NEXT_PUBLIC_) — it
# never reaches the browser; staff exchange it for an httpOnly session cookie.
# Leave unset in local dev and the board runs open. Production fails closed
# without it, including when the public demo flag above is enabled.
KITCHEN_PASSWORD=

# ─── Manager admin (/admin) ────────────────────────────────────
# Password for the local manager admin (prices/discounts/customers). The admin
# is LOCKED unless this is set, and it edits repo config files (writes only work
# locally). Set it ONLY in your local .env.local — do NOT set it on Vercel, so
# /admin stays inert in production.
ADMIN_PASSWORD=

# ─── Payment provider ──────────────────────────────────────────
# tranzila (default) | yaadpay | hyp
PAYMENT_PROVIDER=tranzila

# Tranzila — https://www.tranzila.com/developers
TRANZILA_TERMINAL=

# YaadPay (alternate provider) — https://yaadpay.docs.apiary.io/
YAADPAY_MASOF=
YAADPAY_PASSP=

# Hyp hosted-payment APISign endpoint used by src/lib/hypPay.ts.
# Configure the test terminal's browser return URL as:
# https://yourdomain.com/api/payment/hyp/return
# Do not point Hyp server notifications at /api/payment/webhook. That generic
# endpoint intentionally rejects Hyp until the test-terminal payload is known.
HYP_MASOF=
HYP_KEY=
HYP_PASSP=
# Separate server-only 32-byte encryption key (64 hexadecimal characters).
# Keep stable/backed up while unresolved callbacks exist; do not reuse HYP keys.
# Encrypts complete signed callback evidence, including optional personal fields.
PAYMENT_CALLBACK_ENCRYPTION_KEY=


# Optional. Used only to show a fully attributed Google Maps review on the
# homepage. When either value is absent or Google is unavailable, the UI shows
# a BariBali product-info card instead; it never substitutes a fake testimonial.
# Before enabling, restrict the key to Places API and set a hard quota/budget alert.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=

# Base URL used to build payment success/fail redirect links
NEXT_PUBLIC_APP_URL=http://localhost:3000
