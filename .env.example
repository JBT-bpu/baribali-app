# Copy this file to .env.local and fill in real values.
# NEXT_PUBLIC_* vars are shipped to the browser — never put real secrets there.

# ─── Supabase ──────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only — bypasses Row Level Security. Used by API routes via supabaseAdmin.
SUPABASE_SERVICE_ROLE_KEY=

# ─── Kitchen board ─────────────────────────────────────────────
# Shared-secret gate for /kitchen's API calls. Deterrent only (it's
# NEXT_PUBLIC_ so it ships in the browser bundle) — not real access control.
# Leave unset in local dev; the gate no-ops if empty.
NEXT_PUBLIC_KITCHEN_API_SECRET=

# ─── Payment provider ──────────────────────────────────────────
# tranzila (default) | yaadpay | hyp
PAYMENT_PROVIDER=tranzila

# Tranzila — https://www.tranzila.com/developers
TRANZILA_TERMINAL=

# YaadPay (alternate provider) — https://yaadpay.docs.apiary.io/
YAADPAY_MASOF=
YAADPAY_PASSP=

# Hyp Online (alternate provider, not yet implemented in code)
HYP_API_KEY=
HYP_TERMINAL_ID=

# ─── Misc ───────────────────────────────────────────────────────
# Shown to customers for WhatsApp contact
NEXT_PUBLIC_SHOP_WA_NUMBER=

# Used by the Google Reviews strip on the homepage
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=

# Base URL used to build payment success/fail redirect links
NEXT_PUBLIC_APP_URL=http://localhost:3000
